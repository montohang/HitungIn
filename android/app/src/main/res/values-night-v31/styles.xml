<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dengan mode gelap: values-night lebih diprioritaskan daripada values-v31,
         jadi splash sistem perlu diulang di sini (bukan launch_background lama). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
