  "fixed_sql": [
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"initial_balance\" INTEGER NOT NULL DEFAULT 0, \"icon\" TEXT NOT NULL DEFAULT 'wallet', \"color\" INTEGER NOT NULL DEFAULT 0, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon\" TEXT NOT NULL DEFAULT 'other', \"keywords\" TEXT NOT NULL DEFAULT '', \"color\" INTEGER NOT NULL DEFAULT 0, \"subs\" TEXT NOT NULL DEFAULT '', \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "bills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bills\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL, \"wallet_id\" INTEGER NULL REFERENCES wallets (id) ON DELETE SET NULL, \"next_due\" INTEGER NOT NULL, \"repeat\" TEXT NOT NULL, \"anchor_day\" INTEGER NOT NULL CHECK(\"anchor_day\" BETWEEN 1 AND 31), \"remind_days_before\" INTEGER NOT NULL DEFAULT 1, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "recurring_txs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_txs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"wallet_id\" INTEGER NOT NULL REFERENCES wallets (id), \"to_wallet_id\" INTEGER NULL REFERENCES wallets (id), \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL, \"note\" TEXT NOT NULL DEFAULT '', \"repeat\" TEXT NOT NULL, \"anchor_day\" INTEGER NOT NULL CHECK(\"anchor_day\" BETWEEN 1 AND 31), \"next_run\" INTEGER NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK ((kind = 'transfer') = (to_wallet_id IS NOT NULL)), CHECK (repeat != 'sekali'));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"wallet_id\" INTEGER NOT NULL REFERENCES wallets (id), \"to_wallet_id\" INTEGER NULL REFERENCES wallets (id), \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE SET NULL, \"note\" TEXT NOT NULL DEFAULT '', \"sub\" TEXT NOT NULL DEFAULT '', \"bill_id\" INTEGER NULL REFERENCES bills (id) ON DELETE SET NULL, \"recurring_id\" INTEGER NULL REFERENCES recurring_txs (id) ON DELETE SET NULL, \"occurred_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK ((kind = 'transfer') = (to_wallet_id IS NOT NULL)), CHECK (kind != 'transfer' OR to_wallet_id != wallet_id));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE CASCADE, \"limit_amount\" INTEGER NOT NULL CHECK(\"limit_amount\" >= 0), \"from_month\" INTEGER NOT NULL DEFAULT 946659600, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"category_id\", \"from_month\"));"
        }
      ]
    },
